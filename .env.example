# Copy this file to .env and fill in ONE of the AI providers to turn on the AI planner.
# Without any key the app uses the rule planner (fully working, fully tested).

# Groq (free tier): https://console.groq.com
GROQ_API_KEY=

# or Google Gemini (free tier): https://aistudio.google.com
# GEMINI_API_KEY=

# or local Ollama (free, offline): install from ollama.com, run `ollama pull qwen3:4b`, then:
# SAHRA_LLM=ollama
# OLLAMA_HOST=http://localhost:11434

# Optional: pick a different model name for the provider above
# SAHRA_LLM_MODEL=llama-3.3-70b-versatile

# Optional: Langfuse tracing (https://cloud.langfuse.com) — also run: pip install langfuse
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
